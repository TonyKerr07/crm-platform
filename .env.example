# ============================================================
# CRM Platform - Variáveis de Ambiente
# ============================================================
# COMO USAR:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores no .env
#   3. Nunca suba o .env para o GitHub (já está no .gitignore)
# ============================================================

# ── Banco de Dados ──────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/crmdb
DB_USER=crmuser
DB_PASS=crmpassword

# ── Keycloak ────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# ── OpenAI (opcional) ───────────────────────────────────────
# Sem isso, o sistema usa heurísticas locais para os insights.
# Para habilitar IA real: coloque sua chave e mude para true.
OPENAI_API_KEY=sk-...sua-chave-aqui...
OPENAI_ENABLED=false

# ── Deploy (Railway / Render) ────────────────────────────────
# Preencha após fazer o deploy
# RAILWAY_PROJECT_URL=https://crm-platform-xxx.railway.app
